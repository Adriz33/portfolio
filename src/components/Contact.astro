---
import github from 'devicon/icons/github/github-original.svg?url';
import linkedin from 'devicon/icons/linkedin/linkedin-original.svg?url';

const email = 'adriz6149@gmail.com';

const row = 'group flex items-center gap-4 px-5 py-4 transition-colors hover:bg-surface-2';
const label = 'w-20 shrink-0 font-mono text-xs text-muted';
const arrow = 'font-mono text-muted transition duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-teal-400';

const links = [
  { href: 'https://github.com/Adriz33', name: 'GitHub', value: '@Adriz33', icon: github, invert: true },
  { href: 'https://linkedin.com/in/adrian-peña-gómez97', name: 'LinkedIn', value: 'Adrián Peña Gómez', icon: linkedin, invert: false },
];
---

<section id="contacto" class="mx-auto max-w-6xl px-6 py-20">
  <div class="grid gap-10 md:grid-cols-2">
    <div class="flex flex-col gap-8">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Hablemos</h2>
       
        <p class="mt-6 flex items-center gap-2 font-mono text-sm text-muted">
          <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
          Disponible
        </p>
      </div>

      <ul class="divide-y divide-border overflow-hidden rounded-md border border-border bg-surface">
        <li>
          <a href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`} target="_blank" rel="noopener noreferrer" class={row}>
            <svg class="size-5 shrink-0 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <span class={label}>Email</span>
            <span class="min-w-0 flex-1 font-mono break-all">{email}</span>
            <span class={arrow} aria-hidden="true">↗</span>
            <span class="sr-only">(redactar en Gmail, se abre en una pestaña nueva)</span>
          </a>
        </li>

        {links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class={row}>
              <img src={link.icon} alt="" width="20" height="20" class:list={['size-5 shrink-0', link.invert && 'invert-on-dark']} />
              <span class={label}>{link.name}</span>
              <span class="min-w-0 flex-1">{link.value}</span>
              <span class={arrow} aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Columna derecha: pendiente de decidir */}
    <div></div>
  </div>
</section>
---
const links = [
  { href: '/#proyectos', label: 'proyectos' },
  { href: '/#stack', label: 'stack' },
  { href: '/#formacion', label: 'formación' },
  { href: '/#contacto', label: 'contacto' },
];
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4">
    <a href="/" class="py-2 font-mono text-sm text-fg transition-colors hover:text-accent">
      ~/adrian-pena
    </a>

    <nav aria-label="Principal">
      <ul class="flex flex-wrap gap-x-5 font-mono text-sm">
        {links.map((link) => (
          <li>
            <a href={link.href} class="inline-block py-2 text-muted transition-colors hover:text-fg">
              /{link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
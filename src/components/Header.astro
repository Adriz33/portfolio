---
const links = [
  { href: '/#proyectos', label: 'proyectos' },
  { href: '/#stack', label: 'stack' },
  { href: '/#formacion', label: 'formación' },
  { href: '/#contacto', label: 'contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/70 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4">
    <a href="/" class="flex items-center gap-2 py-2 font-mono text-sm text-fg transition-colors hover:text-accent">
      <img src="/hoguera.webp" alt="" width="200" height="190" class="h-7 w-auto [image-rendering:pixelated]" />
      ~/adrian-peña
    </a>

    <div class="flex items-center gap-4">
      <nav aria-label="Principal">
        <ul class="flex flex-wrap gap-x-5 font-mono text-sm">
          {links.map((link) => (
            <li>
              <a href={link.href} class="inline-block py-2 text-muted transition-colors hover:text-fg">
                /{link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
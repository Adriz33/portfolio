---
import { Image } from 'astro:assets';
import fotoPerfil from '../assets/imgperfil.jpg';


const code: [string, string][][] = [
  [['keyword', 'public class '], ['type', 'AdrianPeña'], ['plain', ' {']],
  [],
  [['plain', '  '], ['keyword', 'private '], ['type', 'String'], ['plain', '  rol = '], ['string', '"Desarrollador web"'], ['plain', ';']],
  [['plain', '  '], ['keyword', 'private '], ['type', 'String'], ['plain', '  busco = '], ['string', '"Empleo"'], ['plain', ';']],
  [['plain', '  '], ['keyword', 'private boolean'], ['plain', ' disponible = '], ['literal', 'true'], ['plain', ';']],
  [['plain', '  '], ['keyword', 'public '], ['type', 'String'], ['plain', ' '], ['method', 'contactar'], ['plain', '() {']],
  [['plain', '    '], ['keyword', 'return '], ['string', '"adriz6149@gmail.com"'], ['plain', ';']],
  [['plain', '  }']],
  [['plain', '}']],

];

const colors: Record<string, string> = {
  comment: 'text-muted',
  keyword: 'text-code-keyword',
  type: 'text-code-type',
  string: 'text-code-string',
  literal: 'text-code-literal',
  method: 'text-code-method',
  plain: '',
};
---

<section class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-[1fr_1.2fr] md:py-28">
  <div class="flex flex-col gap-6">
    <div class="flex items-center gap-4">
      <div class="relative size-24 shrink-0">
        <Image
          src={fotoPerfil}
          alt="Foto de Adrián"
          width={192}
          class="size-24 rounded-full border border-teal-500/70 object-cover object-[50%_42%] shadow-[0_0_14px_-3px_rgba(20,184,166,0.45)]"
        />
        <span class="absolute right-1 bottom-1 size-4 rounded-full border-[3px] border-bg bg-success" aria-hidden="true"></span>
      </div>
      <div class="font-mono text-sm">
        <p>@Adriz33</p>
        <p class="text-muted">disponible = true</p>
      </div>
    </div>

    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Adrián Peña, desarrollador web.
    </h1>

    <p class="max-w-md text-lg text-muted">

      Programador junior en evolución.
      Incidiendo en una lógica legible y escalable.
      En constante aprendizaje, tanto en tecnologías y herramientas como en las buenas prácticas.
      <br><br>
      A programar se aprende programando. Así es y será.



    </p>
  </div>

  <figure class="min-w-0 overflow-hidden rounded-md border border-border bg-surface">
    <figcaption class="sr-only">Mi perfil resumido como una clase de Java</figcaption>
    <div class="flex border-b border-border font-mono text-xs">
      <span class="-mb-px border-b border-accent px-4 py-3">AdrianPeña.java</span>
    </div>
    <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed"><code>{code.map((line, i) => (<span class="block"><span class="mr-4 inline-block w-5 text-right text-muted select-none" aria-hidden="true">{i + 1}</span>{line.map(([kind, text]) => <span class={colors[kind]}>{text}</span>)}</span>))}</code></pre>
  </figure>
</section>
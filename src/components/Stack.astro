---
import html from 'devicon/icons/html5/html5-original.svg?url';
import css from 'devicon/icons/css3/css3-original.svg?url';
import javascript from 'devicon/icons/javascript/javascript-original.svg?url';
import typescript from 'devicon/icons/typescript/typescript-original.svg?url';
import react from 'devicon/icons/react/react-original.svg?url';
import astro from 'devicon/icons/astro/astro-plain.svg?url';
import tailwind from 'devicon/icons/tailwindcss/tailwindcss-original.svg?url';
import java from 'devicon/icons/java/java-original.svg?url';
import mysql from 'devicon/icons/mysql/mysql-original.svg?url';
import git from 'devicon/icons/git/git-original.svg?url';
import figma from 'devicon/icons/figma/figma-original.svg?url';
import vscode from 'devicon/icons/vscode/vscode-original.svg?url';
import intellij from 'devicon/icons/intellij/intellij-original.svg?url';
import eclipse from 'devicon/icons/eclipse/eclipse-original.svg?url';

type Tech = { src: string; name: string; invert?: boolean };

const rows: Tech[][] = [
  [
    { src: html, name: 'HTML' },
    { src: css, name: 'CSS' },
    { src: javascript, name: 'JavaScript' },
    { src: typescript, name: 'TypeScript' },
    { src: react, name: 'React' },
    { src: astro, name: 'Astro', invert: true },
    { src: tailwind, name: 'Tailwind' },
  ],
  [
    { src: java, name: 'Java' },
    { src: mysql, name: 'SQL' },
    { src: git, name: 'Git' },
    { src: figma, name: 'Figma' },
    { src: vscode, name: 'VS Code' },
    { src: intellij, name: 'IntelliJ' },
    { src: eclipse, name: 'Eclipse' },
  ],
];
---

<section id="stack" class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="mb-10 text-3xl font-semibold tracking-tight">Stack</h2>

  <div class="flex flex-col gap-2">
    {rows.map((row, r) => (
      <div class="marquee overflow-hidden py-2">
        <div class:list={['marquee-track flex w-max', r === 1 && 'marquee-reverse']}>
          {[0, 1].map((copy) => (
            <ul class="flex gap-4 pr-4" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map(({ src, name, invert }) => (
                <li class="flex items-center gap-3 rounded-md border border-teal-500/70 bg-surface px-5 py-3 transition duration-200 hover:-translate-y-0.5 hover:border-teal-400 hover:shadow-[0_0_18px_-2px_rgba(20,184,166,0.55)]">
                  <img src={src} alt="" width="22" height="22" class:list={['size-[22px]', invert && 'invert-on-dark']} />
                  <span class="font-mono text-base tracking-wide">{name}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

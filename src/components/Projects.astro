---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';

// Color corporativo de cada tecnología
const techColors: Record<string, string> = {
  React: '#149ECA',
  JavaScript: '#F7DF1E',
  TypeScript: '#3178C6',
  CSS: '#264DE4',
  HTML: '#E34F26',
  Astro: '#BC52EE',
  Tailwind: '#06B6D4',
  Java: '#ED8B00',
  'Spring Boot': '#6DB33F',
  SQL: '#4479A1',
};
---

<section id="proyectos" class="mx-auto max-w-6xl px-6 py-20">
  <div class="mb-10 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-3xl font-semibold tracking-tight">Proyectos</h2>
    <p class="font-mono text-sm text-muted">proyectos.length == {projects.length}</p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <article class="group flex flex-col overflow-hidden rounded-md border border-border bg-surface">
        <a href={project.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" class="block overflow-hidden border-b border-border">
          <Image
            src={project.image}
            alt={`Captura de la web de ${project.name}`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 36rem, 100vw"
            class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>

        <div class="flex flex-1 flex-col gap-4 p-6 sm:p-8">
          <p class="font-mono text-xs text-muted">
            <span class="text-success" aria-hidden="true">●</span> {project.context}
          </p>

          <h3 class="text-2xl font-semibold">{project.name}</h3>

          <div class="flex flex-col gap-3 text-muted">
            <p>{project.problem}</p>
            <p>{project.role}</p>
          </div>

          <ul class="flex flex-wrap gap-2 font-mono text-xs" aria-label="Tecnologías">
            {project.tech.map((tech) => (
              <li class="tech-tag rounded-md border px-2 py-1" style={`--tech: ${techColors[tech] ?? 'var(--c-border-strong)'}`}>{tech}</li>
            ))}
          </ul>

          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto w-fit pt-2 font-medium text-accent underline-offset-4 hover:underline"
          >
            Ver web <span aria-hidden="true">↗</span>
            <span class="sr-only">de {project.name} (se abre en una pestaña nueva)</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .tech-tag {
    border-color: color-mix(in srgb, var(--tech) 65%, transparent);
    background-color: color-mix(in srgb, var(--tech) 14%, transparent);
  }
</style>

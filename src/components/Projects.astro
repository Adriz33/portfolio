---
import { projects } from '../data/projects';
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-20">
  <div class="mb-10 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-3xl font-semibold tracking-tight">Proyectos</h2>
    <p class="font-mono text-sm text-muted">proyectos.length == {projects.length}</p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <article class="flex flex-col gap-4 rounded-xl border border-border bg-surface p-6 sm:p-8">
        <p class="font-mono text-xs text-muted">
          <span class="text-success" aria-hidden="true">●</span> {project.context}
        </p>

        <h3 class="text-2xl font-semibold">{project.name}</h3>

        <div class="flex flex-col gap-3 text-muted">
          <p>{project.problem}</p>
          <p>{project.role}</p>
        </div>

        <ul class="flex flex-wrap gap-2 font-mono text-xs" aria-label="Tecnologías">
          {project.tech.map((tech) => (
            <li class="rounded-md border border-border-strong px-2 py-1">{tech}</li>
          ))}
        </ul>

        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto w-fit pt-2 font-medium text-accent underline-offset-4 hover:underline"
        >
          Ver web <span aria-hidden="true">↗</span>
          <span class="sr-only">de {project.name} (se abre en una pestaña nueva)</span>
        </a>
      </article>
    ))}
  </div>
</section>
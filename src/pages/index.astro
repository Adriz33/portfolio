---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Adrián Peña · Desarrollador web"
  description="Portfolio de Adrián Peña, estudiante de Desarrollo de Aplicaciones Web en Toledo. Proyectos, habilidades técnicas, formación y contacto."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight">Adrián Peña</h1>
    <p class="mt-2 text-muted">Texto secundario en gris.</p>
    <p class="mt-4 font-mono text-sm">
      <span class="text-code-keyword">public class</span>{" "}<span class="text-code-type">Adrian Peña</span> {"{}"}
    </p>
    <div class="mt-6 rounded-xl border border-border bg-surface p-6">
      Una tarjeta con borde y fondo de superficie.
    </div>
  </section>
</Layout>